# Reelscript — variables de entorno (ejemplo)
# Copia este archivo a .env y rellena con las credenciales reales.

# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLASK_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
APIFY_TOKEN=
REDIS_URL=redis://redis:6379/0

# ── v0.19 pricing — Stripe price IDs (suscripciones, add-ons y topups) ────────
# Crea los precios en Stripe (multi-divisa EUR/USD dentro de cada price) y pega
# aquí sus IDs. El código los lee SOLO de estas variables (nunca hardcodeados).
#   Creador: €29/mes · €276/año   ·   Agencia: €129/mes · €1290/año
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
# Add-ons de Agencia (recurrentes):  marca extra €35/mes · asiento extra €19/mes
STRIPE_PRICE_ADDON_BRAND=
STRIPE_PRICE_ADDON_SEAT=
# Topups one-time:  100cr/€19 · 300cr/€49 · 1000cr/€139
STRIPE_TOPUP_PRICE_100=
STRIPE_TOPUP_PRICE_300=
STRIPE_TOPUP_PRICE_1000=
STRIPE_TOPUP_PRICE=                           # legacy (7 usos), opcional

# ── v0.14.24: emails (Resend + PostHog backend) ───────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                       # whsec_... desde Resend dashboard
EMAIL_FROM=Reelscript <contacto@reelscript.net>
EMAIL_REPLY_TO=contacto@reelscript.net
APP_URL=https://reelscript.net
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
