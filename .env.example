# Reelscript — variables de entorno (ejemplo)
# Copia este archivo a .env y rellena con las credenciales reales.

# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLASK_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
APIFY_TOKEN=
STRIPE_TOPUP_PRICE=
REDIS_URL=redis://redis:6379/0

# ── v0.14.24: emails (Resend + PostHog backend) ───────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                       # whsec_... desde Resend dashboard
EMAIL_FROM=Reelscript <contacto@reelscript.net>
EMAIL_REPLY_TO=contacto@reelscript.net
APP_URL=https://reelscript.net
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
